[app]
title = Asphalt AI Bot
package.name = asphaltai
package.domain = com.wmox
source.dir = .
source.include_exts = py,json
version = 1.0
requirements = python3,kivy
orientation = landscape
fullscreen = 0
android.api = 35
android.minapi = 23
android.archs = arm64-v8a,armeabi-v7a
android.permissions = INTERNET,WAKE_LOCK,FOREGROUND_SERVICE

[buildozer]
log_level = 2
warn_on_root = 1
